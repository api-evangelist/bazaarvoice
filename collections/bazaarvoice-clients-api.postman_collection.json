  "info": {
    "_postman_id": "b2804a17-97f2-407d-a4a7-5de2793110d2",
    "name": "Bazaarvoice Content Search Answers Clients API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Bazaarvoice Developer Space V2.0 Content Search API. Provides programmatic search and retrieval of user-generated content (UGC) - Reviews, Questions, Answers, Contributor profiles - plus product catalog lookahead search and structured data (JSON-LD/Microdata) for products. Assembled by API Evangelist from the per-operation OpenAPI definitions published on developers.bazaarvoice.com reference pages.\n\nContact Support:\n Name: Bazaarvoice Developer Support",
      "type": "text/plain"
    }
  }
