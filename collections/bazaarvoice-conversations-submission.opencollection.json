            "method": "POST",
            "url": "https://stg.api.bazaarvoice.com/data/progressiveSubmit.json",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "apiVersion",
                "value": "5.4",
                "type": "query",
                "description": "The API version, e.g. 5.4."
              },
              {
                "name": "action",
                "value": "submit",
                "type": "query",
                "description": "Action is always submit"
              },
              {
                "name": "fields",
                "value": "true",
                "type": "query",
                "description": "A dictionary of form fields for a review form. Format depends on whether \"extended\" parameter is set. fields will be pre-populated with previously submitted content."
              },
              {
                "name": "passkey",
                "value": "caB45h2jBqXFw1OE043qoMBD1gJC8EwFNCjktzgwncXY4",
                "type": "query",
                "description": "API key is required to authenticate API user and check permission to access particular client's data."
              },
              {
                "name": "hostedauth",
                "value": "True",
                "type": "query",
                "description": "Indicates the action being performed, is using hosted authentication"
              },
              {
                "name": "extended",
                "value": "True",
                "type": "query",
                "description": "This parameter is sent as a single key and does not need a value. When omitted, the fields elements are returned in an ordered list that honors the submission field order as specified in the configuration hub, with the exception that required fields are presented first in the ordered list. When included, fields elements are returned in full submission-style format."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
